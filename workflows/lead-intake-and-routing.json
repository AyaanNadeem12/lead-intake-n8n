      "parameters": {
        "jsCode": "const lead = $('Normalize & Enrich').first().json;\nconst found = $input.first().json;\n\nconst existing = found && found.id ? found : null;\n\nconst f = existing ? (existing.fields || existing) : {};\n\nconst prevCount = Number(f['Submission Count']) || 1;\n\nreturn [{\n  json: {\n    ...lead,\n    is_duplicate: !!existing,\n    record_id: existing ? existing.id : null,\n    first_submitted: existing ? (f['First Submitted'] || lead.received_at) : lead.received_at,\n    last_submitted: lead.received_at,\n    submission_count: existing ? prevCount + 1 : 1,\n    previous: existing\n      ? {\n          name: f['Name'],\n          phone: f['Phone'],\n          country: f['Country'],\n          programme: f['Programme'],\n          route: f['Route'],\n        }\n      : null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -112
      ],
      "id": "518e5ec7-a6e9-47e6-8544-541d3d904ae9",
      "name": "Build Record"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\n\nconst fixCase = (s) => {\n  if (s !== s.toLowerCase() && s !== s.toUpperCase()) return s;\n  return s.toLowerCase().replace(/(^|[\\s'-])(\\p{L})/gu, (m, p, c) => p + c.toUpperCase());\n};\n\nconst COUNTRY_DB = [\n  { name: 'Pakistan', region: 'South Asia', aliases: ['pk', 'pak'] },\n  { name: 'India', region: 'South Asia', aliases: ['in', 'bharat'] },\n  { name: 'Bangladesh', region: 'South Asia', aliases: ['bd'] },\n  { name: 'Sri Lanka', region: 'South Asia', aliases: ['lk'] },\n  { name: 'United States', region: 'North America', aliases: ['us', 'usa', 'u.s.', 'u.s.a.', 'america', 'united states of america'] },\n  { name: 'Canada', region: 'North America', aliases: ['ca'] },\n  { name: 'United Kingdom', region: 'Europe', aliases: ['uk', 'gb', 'u.k.', 'great britain', 'britain', 'england'] },\n  { name: 'Germany', region: 'Europe', aliases: ['de'] },\n  { name: 'United Arab Emirates', region: 'Middle East', aliases: ['uae', 'ae'] },\n  { name: 'Saudi Arabia', region: 'Middle East', aliases: ['ksa', 'sa'] },\n  { name: 'Nigeria', region: 'Africa', aliases: ['ng'] },\n  { name: 'China', region: 'East Asia', aliases: ['cn'] },\n  { name: 'Australia', region: 'Oceania', aliases: ['au'] },\n];\n\nconst key = d.country.toLowerCase().replace(/\\s+/g, ' ').trim();\nconst hit = COUNTRY_DB.find(\n  (c) => c.name.toLowerCase() === key || c.aliases.includes(key)\n);\nconst country = hit ? hit.name : fixCase(d.country.replace(/\\s+/g, ' ').trim());\nconst region = hit ? hit.region : 'Unmapped';\n\nconst isOther = d.programme.toLowerCase() === 'other';\nconst rawProgramme = (isOther ? d.programme_other : d.programme).replace(/\\s+/g, ' ').trim();\nconst isCS = rawProgramme.toLowerCase() === 'computer science';\nconst programme = isCS ? 'Computer Science' : rawProgramme;\nconst route = isCS ? 'Computer Science' : 'General';\n\nlet phone = d.phone.replace(/[^\\d+]/g, '');\nif (phone.startsWith('00')) phone = '+' + phone.slice(2);\nphone = phone.replace(/(?!^)\\+/g, '');\n\nreturn [{\n  json: {\n    name: fixCase(d.name.replace(/\\s+/g, ' ').trim()),\n    email: d.email,\n    phone,\n    country,\n    region,\n    programme,\n    route,\n    received_at: new Date().toISOString(),\n  },\n}];"
      },
