        "jsCode": "const r = $('Build Record').first().json;\n\nconst dest = r.route === 'Computer Science'\n  ? $('CS Destination').first().json\n  : $('General Destination').first().json;\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nconst status = r.is_duplicate ? 'UPDATED' : 'NEW';\nconst subject = `[${status}] ${dest.subject_tag} ${r.name} - ${r.programme}`\n  .replace(/[\\r\\n]+/g, ' ');\n\nlet changesHtml = '';\nif (r.is_duplicate) {\n  const labels = { name: 'Name', phone: 'Phone', country: 'Country', programme: 'Programme', route: 'Route' };\n  const rows = [];\n  for (const [k, label] of Object.entries(labels)) {\n    const oldV = (r.previous && r.previous[k]) || '';\n    if (String(oldV) !== String(r[k])) {\n      rows.push(`<li><b>${label}:</b> ${esc(oldV || '(empty)')} &rarr; ${esc(r[k])}</li>`);\n    }\n  }\n  changesHtml = rows.length\n    ? `<p><b>Changes since last submission:</b></p><ul>${rows.join('')}</ul>`\n    : '<p><i>Resubmitted with no changes to their details.</i></p>';\n}\n\nconst row = (label, value) =>\n  `<tr><td style=\"padding:4px 12px 4px 0;color:#666\"><b>${label}</b></td><td>${esc(value)}</td></tr>`;\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px\">\n  <h2 style=\"margin:0 0 8px\">${r.is_duplicate ? 'Returning enquiry (updated)' : 'New enquiry'}</h2>\n  <p>Assigned to: <b>${esc(dest.team)}</b></p>\n  <table>\n    ${row('Name', r.name)}\n    ${row('Email', r.email)}\n    ${row('Phone', r.phone)}\n    ${row('Country', `${r.country} (${r.region})`)}\n    ${row('Programme', r.programme)}\n    ${row('Route', r.route)}\n    ${row('Submissions', r.submission_count)}\n    ${row('First submitted', r.first_submitted)}\n    ${row('Last submitted', r.last_submitted)}\n  </table>\n  ${changesHtml}\n</div>`;\n\nreturn [{ json: { to: dest.notify_to, subject, html } }];"
      },
