    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\n// Trim strings; anything that isn't a string becomes ''\nconst clean = (v) => (typeof v === 'string' ? v.trim() : '');\n// Remove script/style blocks with their contents, then any tags, then stray < >\nconst stripHtml = (s) => s\n  .replace(/<(script|style)[^>]*>[\\s\\S]*?<\\/\\1>/gi, '')\n  .replace(/<[^>]*>/g, '')\n  .replace(/[<>]/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst name = stripHtml(clean(body.name));\nconst email = clean(body.email).toLowerCase();   // unchanged\nconst phone = clean(body.phone);                  // unchanged (already restricted to phone characters)\nconst country = stripHtml(clean(body.country));\nconst programme = stripHtml(clean(body.programme));\nconst programmeOther = stripHtml(clean(body.programme_other));\n\nconst errors = [];\n\n// Name\nif (!name) errors.push({ field: 'name', message: 'Name is required' });\nelse if (name.length > 100) errors.push({ field: 'name', message: 'Name is too long' });\n\n// Email\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nif (!email) errors.push({ field: 'email', message: 'Email is required' });\nelse if (email.length > 254 || !emailRegex.test(email))\n  errors.push({ field: 'email', message: 'Email format is invalid' });\n\n// Phone: lenient, 7-15 digits, only common phone characters\nif (!phone) errors.push({ field: 'phone', message: 'Phone is required' });\nelse {\n  const digits = phone.replace(/\\D/g, '');\n  if (!/^[+\\d\\s().-]+$/.test(phone) || digits.length < 7 || digits.length > 15)\n    errors.push({ field: 'phone', message: 'Phone number is invalid' });\n}\n\n// Country\nif (!country) errors.push({ field: 'country', message: 'Country is required' });\n\n// Programme (+ \"Other\" text box)\nif (!programme) errors.push({ field: 'programme', message: 'Programme is required' });\nelse if (programme.toLowerCase() === 'other' && !programmeOther)\n  errors.push({ field: 'programme_other', message: 'Please specify your programme' });\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    data: { name, email, phone, country, programme, programme_other: programmeOther }\n  }\n}];"
      },
